# Copy this file to ".env" ON THE SERVER ONLY. Never commit the real ".env".
# docker-compose.yml reads these values automatically because this file
# lives next to it (Compose auto-loads a file literally named ".env").

NEO4J_PASSWORD=choose-a-strong-password

LLM_MODEL=openai/YOUR_CHAT_MODEL
LLM_API_KEY=YOUR_CHAT_PROVIDER_KEY
LLM_BASE_URL=https://YOUR_OPENAI_COMPATIBLE_PROVIDER/v1

EMBEDDING_MODEL=openai/YOUR_EMBEDDING_MODEL
EMBEDDING_DIMENSIONS=768
OPENAI_API_KEY=YOUR_EMBEDDING_PROVIDER_KEY
EMBEDDING_BASE_URL=https://YOUR_EMBEDDING_PROVIDER/v1

# Use your server's public IP or domain here, e.g. http://82.115.16.220:8000
CORS_ORIGINS=http://YOUR_SERVER_IP:8000

# Required for verified driving-time recommendations (routing + optional geocoding/nearby).
# Set the real value in the server's .env, never in git.
NESHAN_API_KEY=YOUR_NESHAN_API_KEY
